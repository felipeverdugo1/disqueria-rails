# ==========================================
# Control de versiones y entorno local
# ==========================================
.git
.gitignore
.gitattributes
.env
.env.*

# ==========================================
# IDEs y configuración de editores
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ==========================================
# Logs y archivos temporales de Rails
# ==========================================
log/*
tmp/*
!log/.keep
!tmp/.keep

# ==========================================
# Caches, almacenamiento local y Node/Assets
# ==========================================
storage/*
!storage/.keep
public/assets
public/packs
node_modules/
.byebug_history

# ==========================================
# Secretos y credenciales de Rails
# ==========================================
config/master.key
config/credentials/*.key

# ==========================================
# Docker
# ==========================================
Dockerfile
docker-compose.yml
.dockerignore